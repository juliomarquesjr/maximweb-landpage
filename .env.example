# Este projeto não usa variáveis de ambiente Node para o formulário de contato em produção.
# O envio é feito por PHP + Resend no cPanel. Configure:
#
#   public/contact.config.example.php  → copiar para contact.config.local.php
#   (na mesma pasta pública do site; ver README seção "Formulário de contato (PHP)")
#
# Opcional em desenvolvimento Next (apenas se precisar de outros segredos no futuro):
# NEXT_PUBLIC_...

# Deploy local para cPanel (npm run deploy:cpanel)
CPANEL_FTP_SERVER=ftp.seudominio.com
CPANEL_FTP_USERNAME=usuario_ftp
CPANEL_FTP_PASSWORD=sua_senha_aqui
CPANEL_FTP_SERVER_DIR=/public_html/
CPANEL_FTP_PORT=21
CPANEL_FTP_SECURE=true
CPANEL_FTP_CONCURRENCY=2
